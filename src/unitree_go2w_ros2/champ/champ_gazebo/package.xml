<?xml version="1.0"?>
<package format="3">
  <name>champ_gazebo</name>
  <version>0.1.0</version>
  <description>CHAMP Gazebo Package - Supports Gazebo Classic and Gazebo Garden</description>

  <maintainer email="jimenojmm@gmail.com">Juan Miguel Jimeno</maintainer>
  <author>Juan Miguel Jimeno</author>

  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>launch_ros</build_depend>
  
  <depend>rclcpp</depend>
  <depend>champ</depend>
  <depend>champ_msgs</depend>

  <build_depend condition="$BUILD_GAZEBO_CLASSIC == ON">gazebo_ros2_control</build_depend>
  <build_depend condition="$BUILD_GAZEBO_CLASSIC == ON">gazebo_ros</build_depend>

  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
