<?xml version="1.0" ?>
<sdf version="1.9">
    <world name="tower">
        <physics name="default_physics" default="true" type="dartsim">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
            <real_time_update_rate>1000</real_time_update_rate>
        </physics>

        <scene>
            <ambient>0.8 0.8 0.8 1.0</ambient>
            <background>0.7 0.7 0.7 1.0</background>
            <shadows>false</shadows>
            <grid>false</grid>
        </scene>

        <gui>
            <camera name="user_camera">
                <pose>0.5 21 11 0 0.5 -1.6</pose>
                <view_controller>orbit</view_controller>
            </camera>
        </gui>

        <light type="directional" name="sun">
            <cast_shadows>false</cast_shadows>
            <pose>0 0 20 0 0 0</pose>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
            <attenuation>
                <range>2000</range>
                <constant>0.5</constant>
                <linear>0.001</linear>
                <quadratic>0.0001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <light type="point" name="point_light1">
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
            <attenuation>
                <range>50</range>
                <constant>0.5</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.7 0.7 0.7 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <include>
            <uri>file:///home/ywj/git/3d_dog_navi_ros2/src/ignition_models/gazebo_garden_migration/models/Building/model.sdf</uri>
            <pose>0 0 0 0 0 0</pose>
            <name>building_env</name>
        </include>

        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
        </plugin>
        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
        </plugin>
        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
        </plugin>

    </world>
</sdf>
