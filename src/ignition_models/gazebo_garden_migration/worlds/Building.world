<?xml version="1.0" ?>
<sdf version="1.6">
    <world name="tower">
        <physics name="default_physics" default="true" type="ode">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
            <real_time_update_rate>1000</real_time_update_rate>
            <gravity>0 0 -9.8</gravity>
        </physics>

        <scene>
            <ambient>1.0 1.0 1.0 1.0</ambient>
            <background>0.8 0.8 0.8 1.0</background>
            <shadows>true</shadows>
            <grid>false</grid>
        </scene>

        <gui>
            <camera name="user_camera">
                <pose>0.5 21 11 0 0.5 -1.6</pose>
                <view_controller>orbit</view_controller>
            </camera>
        </gui>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 20 0 0 0</pose>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>1.0 1.0 1.0 1</specular>
            <attenuation>
                <range>2000</range>
                <constant>0.5</constant>
                <linear>0.001</linear>
                <quadratic>0.0001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <light type="point" name="point_light1">
            <pose>0 0 10 0 0 0</pose>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
            <attenuation>
                <range>50</range>
                <constant>0.5</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.7 0.7 0.7 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <include>
            <uri>file:///home/ywj/git/3d_dog_navi_ros2/src/ignition_models/gazebo_garden_migration/models/Building/model.sdf</uri>
            <pose>0 0 0 0 0 0</pose>
            <name>building_env</name>
        </include>

        <!-- Gazebo Garden (gz-sim-7) 插件 -->
        <plugin name='gz::sim::systems::Physics' filename='/usr/lib/x86_64-linux-gnu/gz-sim-7/plugins/libgz-sim7-physics-system.so'/>
        <plugin name='gz::sim::systems::UserCommands' filename='/usr/lib/x86_64-linux-gnu/gz-sim-7/plugins/libgz-sim7-user-commands-system.so'/>
        <plugin name='gz::sim::systems::SceneBroadcaster' filename='/usr/lib/x86_64-linux-gnu/gz-sim-7/plugins/libgz-sim7-scene-broadcaster-system.so'/>
        <plugin name='gz::sim::systems::Contact' filename='/usr/lib/x86_64-linux-gnu/gz-sim-7/plugins/libgz-sim7-contact-system.so'/>
        <plugin name='gz::sim::systems::Imu' filename='/usr/lib/x86_64-linux-gnu/gz-sim-7/plugins/libgz-sim7-imu-system.so'/>
        <plugin name='gz::sim::systems::NavSat' filename='/usr/lib/x86_64-linux-gnu/gz-sim-7/plugins/libgz-sim7-navsat-system.so'/>
        <plugin name='gz::sim::systems::Sensors' filename='/usr/lib/x86_64-linux-gnu/gz-sim-7/plugins/libgz-sim7-sensors-system.so'>
            <render_engine>ogre2</render_engine>
        </plugin>

    </world>
</sdf>
