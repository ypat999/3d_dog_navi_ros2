<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="go2w">
    <pose>0 0 0.6 0 0 0</pose>
    <static>false</static>
    
    <!-- 主体 -->
    <link name="body">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.1 0 0 0</pose>
        <mass>15.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.2</iyy>
          <iyz>0.0</iyz>
          <izz>0.1</izz>
        </inertia>
      </inertial>
      
      <collision name="body_collision">
        <geometry>
          <box>
            <size>0.4 0.2 0.15</size>
          </box>
        </geometry>
      </collision>
      
      <visual name="body_visual">
        <geometry>
          <box>
            <size>0.4 0.2 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- 前左腿 -->
    <link name="fl_hip">
      <pose>0.15 0.1 0 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.001</iyy>
          <iyz>0.0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <collision name="fl_hip_collision">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="fl_hip_visual">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="fl_hip_joint" type="revolute">
      <parent>body</parent>
      <child>fl_hip</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
          <effort>100</effort>
          <velocity>10</velocity>
        </limit>
      </axis>
    </joint>

    <link name="fl_thigh">
      <pose>0.15 0.1 -0.15 0 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0.0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <collision name="fl_thigh_collision">
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="fl_thigh_visual">
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="fl_thigh_joint" type="revolute">
      <parent>fl_hip</parent>
      <child>fl_thigh</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
          <effort>100</effort>
          <velocity>10</velocity>
        </limit>
      </axis>
    </joint>

    <!-- 前右腿 (对称结构) -->
    <link name="fr_hip">
      <pose>0.15 -0.1 0 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.001</iyy>
          <iyz>0.0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <collision name="fr_hip_collision">
        <geometry>
          <cylinder>
