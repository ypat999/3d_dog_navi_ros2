<?xml version="1.0"?>
<model>
  <name>go2w</name>
  <version>1.0</version>
  <sdf version="1.9">go2w.sdf</sdf>

  <author>
    <name>Unitree Robotics</name>
    <email>support@unitree.com</email>
  </author>

  <description>
    Unitree Go2W quadruped robot model for Gazebo Garden simulation.
    This model is compatible with Gazebo Garden and SDFormat 1.9.
  </description>

  <depend>
    <uri>model://sun</uri>
  </depend>
</model>