<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="bigHHH">

    <!-- GUI配置 -->
    <gui fullscreen='false'>
      <camera name='user_camera'>
        <pose>0 0 15 0 0.5 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Gazebo Garden推荐使用dartsim物理引擎 -->
    <physics type="dartsim" name="default_physics" default="true">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.5 0.5 0.5 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>

    <!-- 使用Gazebo Garden的默认光源 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 地面平面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 简化的大型建筑结构 - H形建筑 -->
    <model name="H_building">
      <static>true</static>
      
      <!-- 左侧竖墙 -->
      <link name="left_wall">
        <pose>-25.4 -4.0 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>3.75 0.15 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>3.75 0.15 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>

      <!-- 右侧竖墙 -->
      <link name="right_wall">
        <pose>-25.4 4.0 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>3.75 0.15 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>3.75 0.15 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>

      <!-- 中间横墙 -->
      <link name="middle_wall">
        <pose>-23.0 0.0 1.25 0 0 1.57</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>8.0 0.15 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.0 0.15 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>

      <!-- 添加一些障碍物用于SLAM测试 -->
      <link name="obstacle1">
        <pose>-20.0 2.0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.3 0.6 0.9 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="obstacle2">
        <pose>-18.0 -2.0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.5 0.2 1</ambient>
            <diffuse>0.9 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>

    </model>

    <!-- LIO-SAM机器人模型 -->
    <include>
      <uri>model://lio_sam_robot</uri>
      <name>lio_sam_robot</name>
      <pose>-22.0 0.0 0.5 0 0 0</pose>
    </include>

  </world>
</sdf>