<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="test_zone">

    <!-- GUI配置 -->
    <gui fullscreen='false'>
      <camera name='user_camera'>
        <pose>0 0 10 0 0.5 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Gazebo Garden推荐使用dartsim物理引擎 -->
    <physics type="dartsim" name="default_physics" default="true">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>

    <!-- 使用Gazebo Garden的默认光源 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 地面平面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 测试区域模型 -->
    <include>
      <uri>model://test_zone</uri>
      <name>test_zone</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- 咖啡桌1 -->
    <include>
      <uri>model://cafe_table</uri>
      <name>table1</name>
      <pose>4.05 3 0 0 0 1.57</pose>
    </include>

    <!-- 咖啡桌2 -->
    <include>
      <uri>model://cafe_table</uri>
      <name>table2</name>
      <pose>-3 5 0 0 0 1.57</pose>
    </include>

    <!-- 演示立方体 -->
    <include>
      <uri>model://demo_cube</uri>
      <name>demo_cube</name>
      <pose>3.8 3.15 0.83 0 0 0</pose>
    </include>

    <!-- LIO-SAM机器人模型 -->
    <include>
      <uri>model://lio_sam_robot</uri>
      <name>lio_sam_robot</name>
      <pose>0 0 0.5 0 0 0</pose>
    </include>

  </world>
</sdf>