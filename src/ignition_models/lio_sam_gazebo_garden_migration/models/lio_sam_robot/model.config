<?xml version="1.0"?>
<model>
  <name>lio_sam_robot</name>
  <version>1.0</version>
  <sdf version="1.9">lio_sam_robot.sdf</sdf>

  <author>
    <name>LIO-SAM Project</name>
    <email>support@lio-sam.com</email>
  </author>

  <description>
    LIO-SAM robot with Livox Mid360 laser scanner for Gazebo Garden simulation.
    This model is compatible with Gazebo Garden and SDFormat 1.9.
  </description>

  <depend>
    <uri>model://sun</uri>
  </depend>
</model>